{
  "name": "infogleam-health-poc",
  "version": "1.1.0",
  "private": true,
  "description": "HL7 v2 ADT to FHIR R4 Patient proof of concept with Open Integration Engine (Mirth Connect) and Node.js",
  "scripts": {
    "start": "docker compose up -d --build",
    "stop": "docker compose down",
    "logs:fhir": "docker compose logs -f fhir-app",
    "logs:oie": "docker compose logs -f oie",
    "test": "node --test test/hl7-sender.test.js && npm --prefix fhir-app test",
    "test:send-hl7": "node test-hl7-sender.js samples/sample_adt.hl7",
    "test:send-repeats": "node test-hl7-sender.js samples/sample_adt_a08_repeats.hl7",
    "test:send-oru": "node test-hl7-sender.js samples/sample_lab_result.hl7 --expect AR"
  },
  "keywords": [
    "hl7",
    "fhir",
    "mirth",
    "oie",
    "healthcare",
    "interoperability"
  ],
  "author": "Hisham Alrashdan <hisham@infogleam.com> (https://infogleam.com)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}

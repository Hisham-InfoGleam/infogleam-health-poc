          <com.mirth.connect.plugins.javascriptstep.JavaScriptStep version="4.5.2">
            <name>Build JSON for the FHIR app</name>
            <sequenceNumber>0</sequenceNumber>
            <enabled>true</enabled>
            <script>// Reads PID-3, PID-5, PID-7, PID-8, PID-11 and PID-13 (every repetition) and
// puts them as JSON in the channel map variable &quot;fhirPayload&quot;. The HTTP Sender
// posts that JSON to the FHIR app.
//
// Values are copied exactly as they are in the message. The FHIR app decodes
// the HL7 escape sequences (with the delimiters sent in &quot;delimiters&quot;) and does
// all code mapping. This step writes no patient data to the log.

// Text of component &quot;index&quot; of one field repetition, or &apos;&apos; when it is empty.
// When the component has subcomponents (A&amp;B), &quot;sub&quot; picks one (1 = first).
function component(field, index, sub) {
    sub = sub || 1;
    var name = field.localName() + &apos;.&apos; + index;
    var nodes = field[name];
    if (nodes.length() == 0) {
        return &apos;&apos;;
    }
    var node = nodes[0];
    if (node.hasComplexContent()) {
        var parts = node[name + &apos;.&apos; + sub];
        return parts.length() &gt; 0 ? parts[0].toString() : &apos;&apos;;
    }
    return sub == 1 ? node.toString() : &apos;&apos;;
}

// Every repetition of a field, each one turned into an object by &quot;read&quot;.
function repetitions(segment, fieldName, read) {
    var result = [];
    var fields = segment[fieldName];
    for (var i = 0; i &lt; fields.length(); i++) {
        result.push(read(fields[i]));
    }
    return result;
}

// Component &quot;index&quot; of the first repetition of a field.
function first(segment, fieldName, index) {
    var fields = segment[fieldName];
    return fields.length() &gt; 0 ? component(fields[0], index || 1) : &apos;&apos;;
}

if (msg[&apos;PID&apos;].length() == 0) {
    throw &apos;The message has no PID segment.&apos;;
}
var msh = msg[&apos;MSH&apos;][0];
var pid = msg[&apos;PID&apos;][0];

var payload = {
    messageControlId: first(msh, &apos;MSH.10&apos;),
    messageType: first(msh, &apos;MSH.9&apos;, 1) + &apos;^&apos; + first(msh, &apos;MSH.9&apos;, 2),
    // MSH-1 and MSH-2, for example &quot;|^~\&amp;&quot;. The FHIR app uses them to decode escapes.
    delimiters: msh[&apos;MSH.1&apos;].toString() + msh[&apos;MSH.2&apos;].toString(),
    identifiers: repetitions(pid, &apos;PID.3&apos;, function (cx) {
        return {
            value: component(cx, 1),
            authority: component(cx, 4, 1),
            authorityId: component(cx, 4, 2),
            authorityIdType: component(cx, 4, 3),
            type: component(cx, 5)
        };
    }),
    names: repetitions(pid, &apos;PID.5&apos;, function (xpn) {
        return {
            family: component(xpn, 1, 1),
            given: component(xpn, 2),
            middle: component(xpn, 3),
            suffix: component(xpn, 4),
            prefix: component(xpn, 5),
            type: component(xpn, 7)
        };
    }),
    birthDate: first(pid, &apos;PID.7&apos;),
    gender: first(pid, &apos;PID.8&apos;),
    addresses: repetitions(pid, &apos;PID.11&apos;, function (xad) {
        return {
            street: component(xad, 1, 1),
            other: component(xad, 2),
            city: component(xad, 3),
            state: component(xad, 4),
            postalCode: component(xad, 5),
            country: component(xad, 6),
            type: component(xad, 7)
        };
    }),
    phones: repetitions(pid, &apos;PID.13&apos;, function (xtn) {
        return {
            number: component(xtn, 1),
            use: component(xtn, 2),
            equipment: component(xtn, 3),
            email: component(xtn, 4),
            countryCode: component(xtn, 5),
            areaCode: component(xtn, 6),
            localNumber: component(xtn, 7),
            extension: component(xtn, 8)
        };
    })
};

channelMap.put(&apos;fhirPayload&apos;, JSON.stringify(payload));</script>
          </com.mirth.connect.plugins.javascriptstep.JavaScriptStep>
